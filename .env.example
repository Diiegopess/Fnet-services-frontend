# ==============================================================================
# VARIABLES DE ENTORNO EN VITE
# ==============================================================================
# Importante: En Vite, todas las variables que necesites leer en el frontend
# deben comenzar estrictamente con el prefijo "VITE_". Las variables que no
# tengan este prefijo se mantendrán privadas y no se expondrán al navegador.
# ==============================================================================

# URL Base del Backend:
# Indica la dirección del servidor FastAPI al que el cliente de Axios enviará las peticiones HTTP.
# En desarrollo local apunta a localhost en el puerto 8000 con el prefijo del router (/api/v1).
VITE_API_URL=http://localhost:8000/api/v1

# Identificador de Cliente de Google OAuth 2.0:
# Es la clave pública que identifica a tu aplicación frontend ante los servidores de Google.
# La librería '@react-oauth/google' usa esta ID para solicitar el inicio de sesión del usuario.
VITE_GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com

